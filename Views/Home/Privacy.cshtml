@{
    ViewData["Title"] = "Strona Domowa XP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MainApp</title>
    <link rel="stylesheet" href="~/css/base.css"    asp-append-version="true" />
    <link rel="stylesheet" href="~/css/window.css"  asp-append-version="true" />
    <link rel="stylesheet" href="~/css/apps.css"    asp-append-version="true" />
    <link rel="stylesheet" href="~/css/taskbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/boot.css"    asp-append-version="true" />
</head>
<body class="windows-mode">

    <!-- === BOOT SCREEN === -->
    <div id="boot-screen">
        <div class="boot-logo">
            <div class="boot-flag">
                <div class="boot-flag-pane boot-flag-red"></div>
                <div class="boot-flag-pane boot-flag-green"></div>
                <div class="boot-flag-pane boot-flag-blue"></div>
                <div class="boot-flag-pane boot-flag-yellow"></div>
            </div>
            <div class="boot-logo-text">
                <span class="boot-ms-label">Artur's</span>
                <div>
                    <span class="boot-windows-label">Homepage</span><span class="boot-xp-label">xp</span>
                </div>
            </div>
        </div>
        <div class="boot-progress-wrap">
            <div class="boot-progress-bar">
                <div class="boot-bar-block"></div>
                <div class="boot-bar-block"></div>
                <div class="boot-bar-block"></div>
            </div>
        </div>
        <div class="boot-copyright">Windows XP inspired homepage</div>
        <button id="skip-intro-btn" class="boot-skip-btn">Skip Intro ▶</button>
    </div>

    <!-- === WELCOME SCREEN === -->
    <div id="welcome-screen">
        <div class="welcome-top"></div>
        <div class="welcome-body">
            <p class="welcome-text" data-i18n="welcome-text">Zapraszamy</p>
        </div>
        <div class="welcome-divider"></div>
        <div class="welcome-bottom"></div>
    </div>

    <!-- === SHUTDOWN SCREEN === -->
    <div id="shutdown-screen" class="hidden">
        <div class="shutdown-logo">
            <div class="boot-flag">
                <div class="boot-flag-pane boot-flag-red"></div>
                <div class="boot-flag-pane boot-flag-green"></div>
                <div class="boot-flag-pane boot-flag-blue"></div>
                <div class="boot-flag-pane boot-flag-yellow"></div>
            </div>
            <div class="boot-logo-text">
                <span class="boot-ms-label">Artur's</span>
                <div>
                    <span class="boot-windows-label">Homepage</span><span class="boot-xp-label">xp</span>
                </div>
            </div>
        </div>
        <p class="shutdown-text" data-i18n="shutdown-text">trwa wyłączanie...</p>
    </div>

    <div class="desktop-container">

        <main class="desktop" id="desktop">
            <div class="desktop-icons">

                <div class="desktop-icon" data-app="my-computer">
                    <div class="desktop-icon-image">
                        <img src="/images/IconPack/My Computer.webp" alt="" />
                    </div>
                    <div class="desktop-icon-label" data-i18n="icon-my-computer">Mój komputer</div>
                </div>

                <div class="desktop-icon" data-app="notepad">
                    <div class="desktop-icon-image">
                        <img src="/images/IconPack/Notepad.webp" alt="" />
                    </div>
                    <div class="desktop-icon-label" data-i18n="icon-notepad">Notatnik</div>
                </div>

                <div class="desktop-icon" data-folder="my-projects">
                    <div class="desktop-icon-image">
                        <img src="/images/IconPack/Folder Closed.webp" alt="" />
                    </div>
                    <div class="desktop-icon-label" data-i18n="icon-my-projects">Moje projekty</div>
                </div>


                <div class="desktop-icon" data-app="outlook-express">
                    <div class="desktop-icon-image">
                        <img src="/images/IconPack/Outlook Express.webp" alt="" />
                    </div>
                    <div class="desktop-icon-label" data-i18n="icon-outlook-express">Outlook Express</div>
                </div>

                <div class="desktop-icon" data-app="github-link">
                    <div class="desktop-icon-image">
                        <img src="/images/IconPack/github.svg" alt="" />
                    </div>
                    <div class="desktop-icon-label" data-i18n="icon-github">Notatnik</div>
                </div>

                <div class="desktop-icon" data-app="linkedin-link">
                    <div class="desktop-icon-image">
                        <img src="/images/IconPack/linkedin.webp" alt="" />
                    </div>
                    <div class="desktop-icon-label" data-i18n="icon-linkedin">LinkedIn</div>
                </div>


            </div>
        </main>

        <!-- === START MENU === -->
        <div id="start-menu" class="start-menu hidden">
            <div class="start-menu-header">
                <img src="/images/IconPack/User Accounts.webp" class="start-menu-user-icon" alt="" />
                <span class="start-menu-username">webox</span>
            </div>
            <div class="start-menu-body">

                <!-- left: programs -->
                <div class="start-menu-left">
                    <div class="start-menu-programs">
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Internet Explorer 6.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-ie">Internet Explorer</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Wordpad.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-wordpad">Wordpad</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Windows Media Player 10.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-mpc">Media Player Classic</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Adobe Reader.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-adobe">Adobe Reader</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Outlook Express.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-oe">Outlook Express</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Calculator.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-calc">Kalkulator</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Paint.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-paint">Paint</div>
                        </div>
                        <div class="start-menu-item">
                            <img src="/images/IconPack/Tour XP.webp" alt="" />
                            <div class="start-menu-item-name" data-i18n="start-prog-tour">Samouczek systemu Windows XP</div>
                        </div>
                    </div>
                    <div class="start-menu-item-allprograms">
                        <img src="/images/IconPack/Programs.webp" style="width:16px;height:16px;" alt="" />
                        <span data-i18n="start-allprograms">Wszystkie programy</span>
                        <span class="start-menu-arrow">▶</span>
                    </div>
                </div>

                <!-- right: system links -->
                <div class="start-menu-right">
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/My Pictures.webp" alt="" />
                        <span data-i18n="start-my-pictures">Moje obrazy</span>
                    </div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/My Music.webp" alt="" />
                        <span data-i18n="start-my-music">Moja muzyka</span>
                    </div>
                    <div class="start-menu-separator"></div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/My Computer.webp" alt="" />
                        <span data-i18n="start-my-computer">Mój komputer</span>
                    </div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/Control Panel.webp" alt="" />
                        <span data-i18n="start-control-panel">Panel sterowania</span>
                    </div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/Display Properties.webp" alt="" />
                        <span data-i18n="start-display">Ustawienia ekranu</span>
                    </div>
                    <div class="start-menu-separator"></div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/Help and Support.webp" alt="" />
                        <span data-i18n="start-help">Pomoc i obsługa techniczna</span>
                    </div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/Setup.webp" alt="" />
                        <span data-i18n="start-installer">Instalator</span>
                    </div>
                    <div class="start-menu-separator"></div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/Search.webp" alt="" />
                        <span data-i18n="start-search">Wyszukaj</span>
                    </div>
                    <div class="start-menu-item-right">
                        <img src="/images/IconPack/Run.webp" alt="" />
                        <span data-i18n="start-run">Uruchom…</span>
                    </div>
                </div>

            </div>
            <div class="start-menu-footer">
                <button class="start-menu-footer-btn">
                    <img src="/images/IconPack/Logout.webp" alt="" />
                    <span data-i18n="start-logoff">Wyloguj</span>
                </button>
                <button class="start-menu-footer-btn" id="start-shutdown-btn">
                    <img src="/images/IconPack/Power.webp" alt="" />
                    <span data-i18n="start-shutdown">Wyłącz komputer</span>
                </button>
            </div>
        </div>

        <!-- === LANGUAGE POPUP === -->
        <div id="lang-popup" class="lang-popup hidden">
            <div class="lang-popup-item active" data-lang="pl">
                <span class="lang-popup-flag">🇵🇱</span>
                <span data-i18n="lang-pl">Polski</span>
            </div>
            <div class="lang-popup-item" data-lang="en">
                <span class="lang-popup-flag">🇬🇧</span>
                <span data-i18n="lang-en">English</span>
            </div>
        </div>

        <!-- === SHUTDOWN BALLOON === -->
        <div id="battery-balloon" class="battery-balloon hidden">
            <div class="bb-header">
                <span class="bb-icon"></span>
                <strong class="bb-title"></strong>
                <button class="bb-close" title="Zamknij">✕</button>
            </div>
            <p class="bb-body"></p>
            <p class="bb-hint hidden"></p>
            <button class="bb-extend hidden"></button>
        </div>

        <!-- === SHUTDOWN MENU === -->
        <div id="battery-menu" class="battery-menu hidden">
            <div class="battery-menu-top">
                <img id="battery-menu-icon" src="/images/battery-full.png" alt="" class="battery-menu-icon" />
                <span id="battery-menu-remaining">…</span>
            </div>
            <p class="battery-menu-info" data-i18n="battery-info"></p>
            <hr class="battery-menu-sep" />
            <button id="battery-menu-extend" class="battery-menu-btn"></button>
        </div>

        <footer class="taskbar">
            <div class="taskbar-start" id="start-button">
                <img src="/images/windowsStart.png" alt="" class="start-icon" />
                <span>start</span>
            </div>
            <div class="taskbar-windows">
                <!-- open window buttons -->
            </div>
            <div class="taskbar-tray">
                <div class="tray-lang-btn" id="lang-btn">
                    <img src="/images/IconPack/Change Language.webp" alt="" />
                    <span id="lang-label">PL</span>
                </div>
                <div id="shutdown-battery" class="tray-battery-btn">
                    <img id="battery-icon" src="/images/battery-full.png" alt="" />
                </div>
                <div class="clock">
                    <div class="clock-time">14:32</div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/js/i18n.js"     asp-append-version="true"></script>
    <script src="~/js/registry.js" asp-append-version="true"></script>
    <script src="~/js/windows.js"  asp-append-version="true"></script>
    <script src="~/js/interact.js" asp-append-version="true"></script>
    <script src="~/js/shutdown.js" asp-append-version="true"></script>
    <script src="~/js/boot.js"     asp-append-version="true"></script>
</body>
</html>
