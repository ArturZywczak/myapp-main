@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-5">
    <h1 class="display-4">Hej kochanie &lt;3</h1>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">&#9200; Work Time</h5>
                <p class="card-text text-muted flex-grow-1">Ewidencja czasu pracy</p>
                <a href="/work-time/" class="btn btn-primary mt-auto">Otwórz</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">&#9917; Ekstraklasa Terminal</h5>
                <p class="card-text text-muted flex-grow-1">Tabela ligowa, prognozy, symulacje Monte Carlo</p>
                <a href="/terminal/" class="btn btn-primary mt-auto">Otwórz</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">&#128101; Pracownicy</h5>
                <p class="card-text text-muted flex-grow-1">Aplikacja pracownicy</p>
                <a href="/pracownicy/" class="btn btn-primary mt-auto">Otwórz</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">&#127918; CS Cases</h5>
                <p class="card-text text-muted flex-grow-1">Aplikacja CS:GO Cases</p>
                <a href="/cscases/" class="btn btn-primary mt-auto">Otwórz</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h5 class="card-title">&#128200; Ekstraklasa API</h5>
                <p class="card-text text-muted flex-grow-1">REST API z danymi ligowymi</p>
                <a href="/api/ekstraklasa/swagger" class="btn btn-outline-secondary mt-auto">Swagger</a>
            </div>
        </div>
    </div>
</div>
